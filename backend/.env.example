# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/safedonate

# Auth
JWT_SECRET=change_me_to_a_long_random_string
SESSION_SECRET=another_long_random_string
# Optional. Defaults to "lax" locally and "none" in production (frontend and API on different domains)
# COOKIE_SAMESITE=lax

# URLs
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Default admin (created on first start)
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=change_me

# Email (Gmail app password)
EMAIL_USER=you@gmail.com
EMAIL_PASS=your_gmail_app_password

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Hugging Face (AI fraud score, optional)
HUGGINGFACE_TOKEN=

# Portfolio demo: one-click "Try as Admin/Fundraiser/Donor" accounts.
# Destructive actions are blocked for them and their sample data resets every DEMO_RESET_HOURS.
DEMO_MODE=false
DEMO_RESET_HOURS=24
